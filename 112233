ls -l /tmp/npci-client.p12 || keytool -importkeystore -srckeystore /proc/1/root/nbbl-certs/nbbl_client.jks -srcstoretype JKS -srcstorepass 'sbi@123' \
  -destkeystore /tmp/npci-client.p12 -deststoretype PKCS12 -deststorepass 'sbi@123'

# A) WebClient-style User-Agent, via proxy, with cert
curl -sS -o /tmp/r.html -w 'HTTP=%{http_code} CT=%{content_type}\n' --proxy http://serverswg.sbi.co.in:9090 \
  --cert-type P12 --cert "/tmp/npci-client.p12:sbi@123" \
  -H "Content-Type: application/json" -H "User-Agent: ReactorNetty/1.2.0" \
  -d '{}' "https://ibmbcert.npci.org.in/ibmb/ReqTxnInit/1.0/urn:referenceId:UATEST"; head -c 400 /tmp/r.html 2>/dev/null; echo

# B) No proxy
curl -sS -o /tmp/r2.html -m 15 -w 'HTTP=%{http_code} CT=%{content_type}\n' \
  "https://ibmbcert.npci.org.in/ibmb/ReqTxnInit/1.0/urn:referenceId:UATEST"; head -c 400 /tmp/r2.html 2>/dev/null; echo
