import java.nio.file.*; import java.security.cert.*; import java.util.*; import java.io.*;
public class CertCheck {
  public static void main(String[] a) throws Exception {
    X509Certificate c = (X509Certificate) CertificateFactory.getInstance("X.509").generateCertificate(new FileInputStream(a[0]));
    String s = Files.readString(Path.of(a[1])).replaceAll("-----[A-Z ]+-----","").replaceAll("\\s","");
    System.out.println("Cert subject: " + c.getSubjectX500Principal());
    System.out.println("Cert valid until: " + c.getNotAfter() + "  key alg: " + c.getPublicKey().getAlgorithm());
    System.out.println(Arrays.equals(c.getPublicKey().getEncoded(), Base64.getDecoder().decode(s))
      ? "Shared key == NPCI IBMB cert key" : "Shared key != NPCI IBMB cert key");
  }
}
