import java.nio.file.*; import java.security.*; import java.security.spec.*; import java.util.Base64;
public class KeyCheck {
  static byte[] pem(String f) throws Exception {
    String s = Files.readString(Path.of(f)).replaceAll("-----[A-Z ]+-----", "").replaceAll("\\s", "");
    return Base64.getDecoder().decode(s);
  }
  public static void main(String[] a) throws Exception {
    KeyFactory kf = KeyFactory.getInstance("EC");
    PrivateKey priv = kf.generatePrivate(new PKCS8EncodedKeySpec(pem(a[0])));
    PublicKey  pub  = kf.generatePublic(new X509EncodedKeySpec(pem(a[1])));
    byte[] msg = "keycheck".getBytes();
    Signature s = Signature.getInstance("SHA256withECDSA"); s.initSign(priv); s.update(msg); byte[] sig = s.sign();
    Signature v = Signature.getInstance("SHA256withECDSA"); v.initVerify(pub); v.update(msg);
    System.out.println(v.verify(sig) ? "MATCH - private key pairs with shared public key" : "MISMATCH - keys do NOT pair");
  }
}
